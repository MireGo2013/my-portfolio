{
  "name": "my-portfolio",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @portfolio/api db:migrate",
    "dev:api": "pnpm --filter @portfolio/shared build && pnpm --filter @portfolio/api start:dev",
    "typecheck": "pnpm build && pnpm -r run typecheck",
    "test": "pnpm build && pnpm -r run test",
    "test:e2e": "pnpm build && pnpm --filter @portfolio/api test:e2e",
    "db:seed": "pnpm --filter @portfolio/api db:seed",
    "build": "pnpm -r run build"
  }
}
