{
  "name": "my-portfolio",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @portfolio/api db:migrate",
    "db:seed": "pnpm --filter @portfolio/api db:seed",
    "dev:api": "pnpm --filter @portfolio/shared build && pnpm --filter @portfolio/api start:dev",
    "dev:web": "pnpm --filter @portfolio/shared build && pnpm --filter @portfolio/web dev",
    "gen:api": "pnpm --filter @portfolio/shared --filter @portfolio/api build && pnpm --filter @portfolio/api openapi:export && pnpm --filter @portfolio/web gen:api",
    "build:deps": "pnpm --filter @portfolio/shared --filter @portfolio/api build",
    "build": "pnpm -r run build",
    "typecheck": "pnpm build:deps && pnpm -r run typecheck",
    "test": "pnpm build:deps && pnpm -r run test",
    "test:e2e": "pnpm build:deps && pnpm --filter @portfolio/api test:e2e",
    "test:browser": "pnpm build:deps && pnpm --filter @portfolio/web test:e2e",
    "lint": "pnpm build:deps && eslint . --max-warnings=0",
    "lint:fix": "pnpm build:deps && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,yaml,yml,css,md}": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1"
  }
}
