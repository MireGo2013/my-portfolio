{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDto"
                }
              }
            }
          },
          "503": {
            "description": "База данных недоступна"
          }
        },
        "summary": "Проверка работы API и связи с базой",
        "tags": [
          "Служебное"
        ]
      }
    },
    "/api/v1/profile": {
      "get": {
        "operationId": "ProfileController_get",
        "parameters": [
          {
            "name": "locale",
            "required": false,
            "in": "query",
            "description": "Язык контента, по умолчанию ru",
            "schema": {
              "enum": [
                "ru",
                "en"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileDto"
                }
              }
            }
          },
          "404": {
            "description": "База ещё не заполнена seed-скриптом"
          }
        },
        "summary": "Кто я и как со мной связаться",
        "tags": [
          "Контент"
        ]
      }
    },
    "/api/v1/experience": {
      "get": {
        "operationId": "ExperienceController_list",
        "parameters": [
          {
            "name": "locale",
            "required": false,
            "in": "query",
            "description": "Язык контента, по умолчанию ru",
            "schema": {
              "enum": [
                "ru",
                "en"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExperienceDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Опыт работы в порядке показа на сайте",
        "tags": [
          "Контент"
        ]
      }
    },
    "/api/v1/projects": {
      "get": {
        "operationId": "ProjectsController_list",
        "parameters": [
          {
            "name": "locale",
            "required": false,
            "in": "query",
            "description": "Язык контента, по умолчанию ru",
            "schema": {
              "enum": [
                "ru",
                "en"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProjectDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Открытые и фриланс-проекты",
        "tags": [
          "Контент"
        ]
      }
    },
    "/api/v1/skills": {
      "get": {
        "operationId": "SkillsController_list",
        "parameters": [
          {
            "name": "locale",
            "required": false,
            "in": "query",
            "description": "Язык контента, по умолчанию ru",
            "schema": {
              "enum": [
                "ru",
                "en"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SkillCategoryDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Стек, сгруппированный по областям",
        "tags": [
          "Контент"
        ]
      }
    },
    "/api/v1/contact": {
      "post": {
        "operationId": "ContactController_submit",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateContactMessageDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Сообщение принято"
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorDto"
                }
              }
            }
          },
          "429": {
            "description": "Превышен лимит отправок"
          }
        },
        "summary": "Отправить сообщение через форму контактов",
        "tags": [
          "Контакты"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Не больше 5 попыток за 15 минут с одного IP.",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Вход выполнен"
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "Неверная почта или пароль"
          },
          "429": {
            "description": "Слишком много попыток"
          }
        },
        "summary": "Войти: ставит cookie сессии",
        "tags": [
          "Вход в админку"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Cookie обновлены"
          },
          "401": {
            "description": "Сессия недействительна"
          }
        },
        "summary": "Обновить токены по cookie обновления",
        "tags": [
          "Вход в админку"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Сессия завершена"
          }
        },
        "summary": "Выйти: удаляет сессию на сервере и cookie",
        "tags": [
          "Вход в админку"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserDto"
                }
              }
            }
          },
          "401": {
            "description": "Нет сессии или она истекла"
          },
          "403": {
            "description": "Нет прав или запрос с чужого сайта"
          }
        },
        "security": [
          {
            "admin_access": []
          }
        ],
        "summary": "Кто вошёл",
        "tags": [
          "Вход в админку"
        ]
      }
    }
  },
  "info": {
    "title": "Portfolio API",
    "description": "REST API сайта-портфолио Владислава Соболя",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "admin_access"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "up"
            ]
          }
        },
        "required": [
          "status",
          "database"
        ]
      },
      "ProfileDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "Владислав Соболь"
          },
          "title": {
            "type": "string",
            "example": "Fullstack Engineer"
          },
          "specialization": {
            "type": "string",
            "example": "React / TypeScript / Node.js / NestJS"
          },
          "shortName": {
            "type": "string",
            "example": "Влад",
            "description": "Имя для приветствия"
          },
          "summary": {
            "type": "string",
            "description": "Короткое описание для поисковиков"
          },
          "about": {
            "description": "История о себе, по абзацам",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "telegramUrl": {
            "type": "string",
            "format": "uri"
          },
          "githubUrl": {
            "type": "string",
            "format": "uri"
          },
          "linkedinUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "fullName",
          "title",
          "specialization",
          "shortName",
          "summary",
          "about",
          "email",
          "telegramUrl",
          "githubUrl",
          "linkedinUrl"
        ]
      },
      "ExperienceDto": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "scooter-admin-crm"
          },
          "company": {
            "type": "string",
            "nullable": true,
            "description": "null, если проект указан без компании",
            "example": "Sparkit / BE Happy"
          },
          "project": {
            "type": "string",
            "example": "Scooter Admin CRM"
          },
          "role": {
            "type": "string",
            "example": "Lead Frontend Engineer"
          },
          "summary": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "example": "2025-08",
            "description": "Месяц начала, YYYY-MM"
          },
          "endDate": {
            "type": "string",
            "nullable": true,
            "example": "2025-11",
            "description": "Месяц окончания, YYYY-MM. null, если работа продолжается"
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "achievements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stack": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "slug",
          "company",
          "project",
          "role",
          "summary",
          "startDate",
          "endDate",
          "responsibilities",
          "achievements",
          "stack"
        ]
      },
      "ProjectKind": {
        "type": "string",
        "enum": [
          "OPEN_SOURCE",
          "FREELANCE"
        ]
      },
      "ProjectDto": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "paint-online"
          },
          "name": {
            "type": "string",
            "example": "Paint Online"
          },
          "kind": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProjectKind"
              }
            ]
          },
          "description": {
            "type": "string"
          },
          "stack": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "repoUrl": {
            "type": "string",
            "nullable": true,
            "format": "uri"
          },
          "liveUrl": {
            "type": "string",
            "nullable": true,
            "format": "uri"
          }
        },
        "required": [
          "slug",
          "name",
          "kind",
          "description",
          "stack",
          "repoUrl",
          "liveUrl"
        ]
      },
      "SkillCategoryDto": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "backend"
          },
          "name": {
            "type": "string",
            "example": "Backend"
          },
          "skills": {
            "example": [
              "Node.js",
              "NestJS"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "slug",
          "name",
          "skills"
        ]
      },
      "CreateContactMessageDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "example": "Анна"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "anna@example.com"
          },
          "message": {
            "type": "string",
            "minLength": 10,
            "maxLength": 5000,
            "example": "Здравствуйте! Хотим обсудить вакансию."
          },
          "website": {
            "type": "string",
            "maxLength": 200,
            "description": "Защита от ботов: должно оставаться пустым"
          }
        },
        "required": [
          "name",
          "email",
          "message"
        ]
      },
      "ValidationErrorDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Ошибка валидации"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "example": {
              "email": [
                "emailInvalid"
              ]
            }
          }
        },
        "required": [
          "message",
          "errors"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "admin@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AdminRole": {
        "type": "string",
        "enum": [
          "ADMIN"
        ]
      },
      "AdminUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AdminRole"
              }
            ]
          }
        },
        "required": [
          "id",
          "email",
          "role"
        ]
      }
    }
  }
}
