# Локальная база из compose.yaml. Для работы скопируй этот файл в .env
DATABASE_URL="postgresql://portfolio:portfolio@127.0.0.1:5432/portfolio"
PORT=3001

# Адрес сайта: только ему браузер разрешит отправлять форму
CORS_ORIGIN=http://localhost:3000

# Необязательно. Без них сообщения сохраняются в базу, но уведомлений нет.
# Токен выдаёт @BotFather. Настоящие значения пиши только в .env
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Только за прокси, который сам выставляет X-Real-IP (например, Railway)
TRUST_X_REAL_IP=false

# Подпись токенов админки, минимум 32 символа. Сгенерировать:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Первый администратор: создаётся при старте, если в базе ещё никого нет.
# Пароль от 12 символов. После создания переменные можно удалить
ADMIN_EMAIL=
ADMIN_PASSWORD=
