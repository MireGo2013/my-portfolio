# Адрес API без префикса. Для работы скопируй этот файл в .env.local
# Только для сервера Next.js: без NEXT_PUBLIC_ в браузер он не попадает
API_URL=http://127.0.0.1:3001

# Форма контактов обращается к API прямо из браузера, поэтому адрес публичный
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Только на Vercel: тот же секрет, что у API. С ним API верит IP посетителя,
# который передаёт админка, и лимит попыток входа считается для каждого отдельно.
# Локально не нужен: здесь заголовок с IP мог бы подставить кто угодно
PROXY_SECRET=
